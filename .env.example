# Copy this file to .env and fill in real values. Never commit the real .env file.
# On Hugging Face, set these as Space "Secrets" instead of using a .env file.

# --- General ---
ENVIRONMENT=development
DEBUG=false

# --- Database ---
# SQLite (default, used by the Hugging Face Space):
DATABASE_URL=sqlite:///./triage_data.db
# PostgreSQL (docker-compose): postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# --- Agent 3: Groq LLM ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxx_REPLACE_WITH_YOUR_KEY
GROQ_MODEL_NAME=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Agent 1: Whisper ---
WHISPER_MODEL_NAME=base.en
AUDIO_TEMP_DIR=/tmp/nhs_triage_audio

# --- Agent 2: evidence retrieval ---
MAX_SIMILAR_CASES=5
RETRIEVAL_WEIGHT_COMPLAINT=1.0
RETRIEVAL_WEIGHT_DIAGNOSIS=0.7
RETRIEVAL_WEIGHT_VITALS=0.5
RETRIEVAL_WEIGHT_MEDICATION=0.3

# --- Agent 5: Twilio WhatsApp alerts ---
# Leave any of these blank (or set TWILIO_TEST_MODE=true) and alerts are
# logged as "mocked" instead of sent.
TWILIO_ACCOUNT_SID=ACxxxxxxxx_REPLACE_WITH_YOUR_SID
TWILIO_AUTH_TOKEN=xxxxxxxx_REPLACE_WITH_YOUR_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
DOCTOR_WHATSAPP_NUMBER=+1234567890
TWILIO_TEST_MODE=true
# JSON list of severities that trigger an alert
ALERT_ON_SEVERITIES=["High"]

# --- Agents 6 & 7: monitoring, drift and bias ---
MONITORING_WINDOW_DAYS=30
ACCURACY_ALERT_THRESHOLD=0.85
DRIFT_SCORE_THRESHOLD=0.3
BIAS_P_VALUE_THRESHOLD=0.05
MIN_FEEDBACK_FOR_ACCURACY_ALERT=10
MIN_SESSIONS_FOR_DRIFT=10

# --- Admin protection & notifications ---
# Required header X-Admin-Key for /feedback, /alerts and /admin/*. Set this in production.
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
# Optional: email critical alerts (accuracy < 85%, drift > 0.3) to the admin.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gradio frontend (app.py) ---
DOCTOR_PORTAL_PIN=REPLACE_WITH_A_PIN
BACKEND_URL=http://127.0.0.1:8000

# --- CORS (JSON list) ---
CORS_ALLOW_ORIGINS=["*"]
